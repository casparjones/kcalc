# Docksal Environment Configuration
# Diäthelfer Kalorienbedarf Rechner

# Use default stack (web only, no database needed)
DOCKSAL_STACK=default

# Virtual host for the project
VIRTUAL_HOST=kcalc.docksal.site

# Project name
COMPOSE_PROJECT_NAME=kcalc

# Web server document root
DOCROOT=.

# No database needed for static site
